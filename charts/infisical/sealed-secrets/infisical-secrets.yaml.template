apiVersion: v1
kind: Secret
metadata:
  name: infisical-secrets
  namespace: default
type: Opaque
stringData:
  # Irreplaceable — losing this makes stored secrets undecryptable. Back up outside the cluster.
  ENCRYPTION_KEY: "REPLACE_WITH_openssl_rand_hex_16"
  AUTH_SECRET: "REPLACE_WITH_openssl_rand_base64_32"
  SITE_URL: "https://infisical.jarrodservilla.com"
  POSTGRES_USER: "infisical"
  POSTGRES_PASSWORD: "REPLACE_WITH_DB_PASSWORD"
  POSTGRES_DB: "infisical"
  DB_CONNECTION_URI: "postgresql://infisical:REPLACE_WITH_DB_PASSWORD@infisical-postgres:5432/infisical"
  # Shared Valkey, logical db 2 (db0=immich, db1=authentik), no auth
  REDIS_URL: "redis://valkey.default.svc.cluster.local:6379/2"
