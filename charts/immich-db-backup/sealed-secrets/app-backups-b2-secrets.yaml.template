# Template for B2 credentials secret
# Fill in the values and seal using: make seal-secret CHART=immich-db-backup SECRET=app-backups-b2-secrets
apiVersion: v1
kind: Secret
metadata:
  name: app-backups-b2-secrets
  namespace: default
type: Opaque
stringData:
  # Backblaze B2 Application Key ID
  AWS_ACCESS_KEY_ID: "YOUR_B2_KEY_ID"
  # Backblaze B2 Application Key
  AWS_SECRET_ACCESS_KEY: "YOUR_B2_APPLICATION_KEY"
  # Restic repository encryption password
  RESTIC_PASSWORD: "YOUR_RESTIC_PASSWORD"
