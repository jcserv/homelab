# Template for B2 credentials secret
# Fill in the values and seal using: make seal-secret CHART=restic-backup SECRET=restic-b2-secrets
apiVersion: v1
kind: Secret
metadata:
  name: restic-b2-secrets
  namespace: default
type: Opaque
stringData:
  # Backblaze B2 Application Key ID
  AWS_ACCESS_KEY_ID: "YOUR_B2_KEY_ID"
  # Backblaze B2 Application Key
  AWS_SECRET_ACCESS_KEY: "YOUR_B2_APPLICATION_KEY"
  # Backblaze B2 repository (format: s3:s3.us-west-004.backblazeb2.com/bucket-name/path)
  RESTIC_REPOSITORY: "YOUR_RESTIC_REPOSITORY"
  # Restic repository encryption password
  RESTIC_PASSWORD: "YOUR_RESTIC_PASSWORD"
