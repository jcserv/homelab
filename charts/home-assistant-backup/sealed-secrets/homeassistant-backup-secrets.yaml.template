# Template for Home Assistant backup secrets
# Fill in the values and seal using: make seal-secret CHART=home-assistant-backup SECRET=homeassistant-backup-secrets
apiVersion: v1
kind: Secret
metadata:
  name: homeassistant-backup-secrets
  namespace: default
type: Opaque
stringData:
  # Home Assistant Long-Lived Access Token
  # Create one in Home Assistant: Profile -> Security -> Long-Lived Access Tokens
  HA_API_TOKEN: "YOUR_HOME_ASSISTANT_TOKEN"
